# VISION: Vital Intelligence for System Integrity, Observation & Nostics
# Environment Configuration Template

# FastAPI Backend Host and Port
API_HOST=127.0.0.1
API_PORT=8000

# Frontend Vite API Gateway (used by Vite dev server and API client)
VITE_API_URL=http://127.0.0.1:8000

# Debug mode (enables verbose Swagger UI & detailed logging)
DEBUG=True

# C-MAPSS Raw Dataset Location (relative to repo root)
CMAPSS_DIR=data/raw

# Default C-MAPSS Subset Identifier (FD001, FD002, FD003, FD004)
DEFAULT_SUBSET=FD001

# Piecewise linear RUL saturation cap (standard NASA benchmark convention = 125 cycles)
RUL_CAP=125


